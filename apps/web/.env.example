# Copy to .env.local for local development.
API_INTERNAL_URL=http://localhost:4000
# Hosts that serve the hotel staff admin (everything else is a tenant website)
APP_HOSTS=localhost,127.0.0.1
REVALIDATE_SECRET=change-me
# Super Admin console on its own origin (npm run dev:platform serves it on :3001). Remove both to share the admin host.
PLATFORM_HOST=localhost:3001
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3001
