{
	# Issue certificates on demand for verified tenant domains only.
	on_demand_tls {
		ask http://api:4000/api/v1/public/tls-allowed
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
	}
	reverse_proxy web:3000
}
