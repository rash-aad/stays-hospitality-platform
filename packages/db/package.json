{
  "name": "@hp/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "setup": "tsx src/setup.ts",
    "migrate": "tsx src/setup.ts && tsx src/migrate.ts",
    "seed": "tsx src/seed/index.ts",
    "reset": "tsx src/reset.ts && tsx src/migrate.ts && tsx src/seed/index.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}